{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@pi-gui/session-driver": ["src/lib/pi-gui/session-driver/index.ts"],
      "@pi-gui/session-driver/types": ["src/lib/pi-gui/session-driver/types.ts"],
      "@pi-gui/session-driver/runtime-types": ["src/lib/pi-gui/session-driver/runtime-types.ts"],
      "@pi-gui/catalogs": ["src/lib/pi-gui/catalogs/index.ts"],
      "@pi-gui/pi-sdk-driver": ["src/lib/pi-gui/pi-sdk-driver/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "e2e", "**/*.test.ts"]
}
